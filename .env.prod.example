# Public endpoints
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
API_HOST=api.example.com
FRONTEND_HOST=example.com
DEFAULT_URI=https://api.example.com
CLIENT_ACTIVATION_URL=https://example.com/activate/
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Host paths. TLS_CERTS_DIR must contain fullchain.pem and privkey.pem.
TLS_CERTS_DIR=/srv/evogym/secrets/tls
JWT_KEYS_DIR=/srv/evogym/secrets/jwt
POSTGRES_BACKUP_DIR=/srv/evogym-backups/postgres
POSTGRES_BACKUP_RETENTION_DAYS=14

# Optional image tags for a registry-based deployment
PHP_IMAGE=evogym-php:prod
NGINX_IMAGE=evogym-nginx:prod
FRONTEND_IMAGE=evogym-frontend:prod

# Symfony
APP_TIMEZONE=UTC
APP_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
MAILER_DSN=smtp://REPLACE_WITH_SMTP_DSN
CONTACT_RECIPIENT_EMAIL=contact@example.com
CONTACT_SENDER_EMAIL=noreply@example.com
JWT_PASSPHRASE=REPLACE_WITH_STRONG_JWT_PASSPHRASE
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY

# PostgreSQL. URL-encode reserved characters in DATABASE_URL credentials.
POSTGRES_VERSION=16
POSTGRES_DB=gym_database
POSTGRES_USER=evogym
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
DATABASE_URL=postgresql://evogym:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/gym_database?serverVersion=16&charset=utf8

# Redis
REDIS_URL=redis://redis:6379?timeout=1&read_write_timeout=1

# RabbitMQ
RABBITMQ_DEFAULT_USER=evogym
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD
MESSENGER_TRANSPORT_DSN=amqp://evogym:REPLACE_WITH_URL_ENCODED_RABBITMQ_PASSWORD@rabbitmq:5672/%2f/messages

# ClickHouse
CLICKHOUSE_HOST=http://clickhouse:8123/
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD

# MinIO
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=evogym-bucket
MINIO_ENDPOINT=http://minio:9000
