# Public endpoints
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
API_HOST=api.example.com
FRONTEND_HOST=example.com
DEFAULT_URI=https://api.example.com
CLIENT_ACTIVATION_URL=https://example.com/activate/
AUTH_COOKIE_DOMAIN=.example.com
CORS_ALLOW_ORIGIN='^https:[/][/]example[.]com$'
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Host paths. TLS_CERTS_DIR must contain fullchain.pem and privkey.pem.
TLS_CERTS_DIR=/srv/evogym/secrets/tls
JWT_KEYS_DIR=/srv/evogym/secrets/jwt
POSTGRES_BACKUP_DIR=/srv/evogym-backups/postgres
POSTGRES_BACKUP_RETENTION_DAYS=14

# Optional image tags for a registry-based deployment
PHP_IMAGE=evogym-php:prod
NGINX_IMAGE=evogym-nginx:prod
FRONTEND_IMAGE=evogym-frontend:prod

# Symfony
APP_TIMEZONE=UTC
APP_SECRET=CHANGE_ME
MAILER_DSN=null://null
CONTACT_RECIPIENT_EMAIL=contact@example.com
CONTACT_SENDER_EMAIL=noreply@example.com
JWT_PASSPHRASE=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLIC_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME

# PostgreSQL. Replace the example URL with credentials suitable for the deployment.
POSTGRES_VERSION=16
POSTGRES_DB=gym_database
POSTGRES_USER=evogym
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres@postgres:5432/gym_database?serverVersion=16&charset=utf8

# Redis
REDIS_URL=redis://redis:6379?timeout=1&read_write_timeout=1

# RabbitMQ. Replace the example DSN with deployment credentials.
RABBITMQ_DEFAULT_USER=evogym
RABBITMQ_DEFAULT_PASS=CHANGE_ME
MESSENGER_TRANSPORT_DSN=amqp://rabbitmq:5672/%2f/messages

# ClickHouse
CLICKHOUSE_HOST=http://clickhouse:8123/
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=CHANGE_ME

# MinIO
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=evogym-bucket
MINIO_ENDPOINT=http://minio:9000
