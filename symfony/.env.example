APP_ENV=prod
APP_TIMEZONE=UTC
APP_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
APP_SHARE_DIR=/var/www
DEFAULT_URI=https://localhost
CLIENT_ACTIVATION_URL=https://evogym.local/activate/
AUTH_COOKIE_DOMAIN=.evogym.local
CORS_ALLOW_ORIGIN=https://evogym.local

DATABASE_URL="postgresql://postgres:REPLACE_WITH_DB_PASSWORD@postgres:5432/gym_database?serverVersion=16&charset=utf8"
REDIS_URL="redis://redis:6379?timeout=1&read_write_timeout=1"
MESSENGER_TRANSPORT_DSN="amqp://user:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/%2f/messages"
MAILER_DSN=smtp://mailpit:1025
CONTACT_RECIPIENT_EMAIL=contact@evogym.local
CONTACT_SENDER_EMAIL=noreply@evogym.local

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=REPLACE_WITH_STRONG_JWT_PASSPHRASE

STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

CLICKHOUSE_HOST=http://clickhouse:8123/
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD

MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=evogym-bucket
MINIO_ENDPOINT=http://minio:9000
