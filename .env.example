# Docker Compose
# The development override is selected automatically after this file is copied to .env.
COMPOSE_PROJECT_NAME=evogym-dev
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=:

# Host binding
# Keep development services reachable only from the local machine by default.
BIND_ADDRESS=127.0.0.1

# Application
APP_ENV=dev
APP_TIMEZONE=UTC
APP_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
DEFAULT_URI=https://api.evogym.local
CLIENT_ACTIVATION_URL=https://evogym.local/activate/
ACTIVATION_EMAIL_SENDER=noreply@evogym.local
AUTH_COOKIE_DOMAIN=.evogym.local
CORS_ALLOW_ORIGIN='^https://evogym\.local$'
MAILER_DSN=smtp://mailpit:1025
CONTACT_RECIPIENT_EMAIL=contact@evogym.local
CONTACT_SENDER_EMAIL=noreply@evogym.local

# Web
NGINX_PORT=80
SECURE_NGINX_PORT=443

# PHP
PHP_VERSION=8.4
PHP_FPM_PORT=9000

# Database
POSTGRES_PORT=5432
POSTGRES_VERSION=16
POSTGRES_DB=gym_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# Infrastructure
PGADMIN_PORT=8080
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_PGADMIN_PASSWORD
REDIS_PORT=6379
NEXT_PORT=3000
RABBITMQ_UI_PORT=15672
RABBITMQ_AMQP_PORT=5672
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD
CLICKHOUSE_API_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
MAILPIT_PORT=1025
MAILPIT_INTERFACE_PORT=8025

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=REPLACE_WITH_STRONG_JWT_PASSPHRASE

# Stripe
# The setup script replaces these with non-secret local placeholders. Replace them with
# real Stripe test credentials only when payment flows need to be exercised.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# MinIO
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=evogym-bucket

# Xdebug
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CONFIG=client_host=host.docker.internal
PHP_IDE_CONFIG=serverName=docker-cli
