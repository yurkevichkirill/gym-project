# Web
NGINX_PORT=80
SECURE_NGINX_PORT=443

# PHP
PHP_VERSION=8.4
PHP_FPM_PORT=9000

# Database
POSTGRES_PORT=5432
POSTGRES_VERSION=16
POSTGRES_DB=gym_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Infrastructure
PGADMIN_PORT=8080
REDIS_PORT=6379
VITE_PORT=5173
NEXT_PORT=3000
RABBITMQ_UI_PORT=15672
RABBITMQ_AMQP_PORT=5672
CLICKHOUSE_API_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MAILPIT_PORT=1025
MAILPIT_INTERFACE_PORT=8025

