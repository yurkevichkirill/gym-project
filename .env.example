# Host binding
# Keep development services reachable only from the local machine by default.
BIND_ADDRESS=127.0.0.1

# Web
NGINX_PORT=80
SECURE_NGINX_PORT=443

# PHP
PHP_VERSION=8.4
PHP_FPM_PORT=9000

# Database
POSTGRES_PORT=5432
POSTGRES_VERSION=16
POSTGRES_DB=gym_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# Infrastructure
PGADMIN_PORT=8080
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_PGADMIN_PASSWORD
REDIS_PORT=6379
NEXT_PORT=3000
RABBITMQ_UI_PORT=15672
RABBITMQ_AMQP_PORT=5672
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD
CLICKHOUSE_API_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
MAILPIT_PORT=1025
MAILPIT_INTERFACE_PORT=8025

# MinIO Configuration
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD

# Xdebug
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CONFIG=client_host=host.docker.internal start_with_request=trigger
PHP_IDE_CONFIG=serverName=docker-cli
